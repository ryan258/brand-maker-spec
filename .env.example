# Required. Create an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides. Defaults are current as of 2026-07-23.
BRAND_MAKER_PRIMARY_MODEL=poolside/laguna-s-2.1:free
BRAND_MAKER_FALLBACK_MODEL=anthropic/claude-sonnet-4.5
