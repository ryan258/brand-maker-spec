# Required. Create an API key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Optional overrides. Defaults are current as of 2026-07-23.
BRAND_MAKER_PRIMARY_MODEL=poolside/laguna-s-2.1:free
BRAND_MAKER_FALLBACK_MODEL=anthropic/claude-sonnet-4.5
BRAND_MAKER_JUDGE_MODEL=anthropic/claude-sonnet-4.5
# OpenRouter image model for AI logo generation. See https://openrouter.ai/models?fmt=table&output_modalities=image
BRAND_MAKER_IMAGE_MODEL=google/gemini-2.5-flash-image-preview
BRAND_MAKER_REQUEST_TIMEOUT_SECONDS=45
BRAND_MAKER_DATABASE_PATH=.brand-maker/brands.db
